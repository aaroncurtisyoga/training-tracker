{
  "name": "training-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npx tsc --noEmit && node scripts/check-proxy-matcher.mjs",
    "validate": "npm run check && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "garmin:login": "tsx scripts/garmin-login.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "bash -c 'npx tsc --noEmit'"
    ],
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.5",
    "@prisma/client": "^6.14.0",
    "clsx": "^2.1.1",
    "garmin-connect": "^1.6.2",
    "lucide-react": "^0.541.0",
    "next": "^16.3.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@clerk/testing": "^1.13.26",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.28",
    "prettier": "^3.2.5",
    "prisma": "^6.14.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "last 2 edge versions"
  ]
}
