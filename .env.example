# --- Database ---------------------------------------------------------------
# The `training` database inside the same Neon project as aaroncurtisyoga.com.
# Same compute endpoint, so this adds no compute cost — only the database name
# differs from the site's values. Vercel's Neon integration does NOT keep these
# in sync, so when the site's credentials rotate these need updating by hand.
# Pooled, used by the app.
POSTGRES_PRISMA_URL=
# Direct, used by migrations.
POSTGRES_URL_NON_POOLING=

# --- Auth -------------------------------------------------------------------
# Same Clerk production instance as aaroncurtisyoga.com. Sessions are shared
# across subdomains of the root domain by default, so there is no satellite
# config here and NEXT_PUBLIC_CLERK_DOMAIN / isSatellite are deliberately unset.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# --- Garmin -----------------------------------------------------------------
# Long-lived OAuth tokens, about a year of validity. Mint once with
# `npm run garmin:login`, which writes the gitignored .garmin-tokens.json.
# loadTokens() reads this env var first and falls back to that file, so this is
# mainly needed on Vercel. No password is ever stored.
GARMIN_TOKENS=
# Passed to the Garmin client as a username. Token auth doesn't use it.
GARMIN_EMAIL=

# --- Cron -------------------------------------------------------------------
# Gates /api/cron/sync-garmin. assertCronRequest returns 401 when this is unset,
# so a missing value fails the nightly job silently apart from the Vercel log.
CRON_SECRET=

# --- Testing ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLERK_PUBLISHABLE_KEY=
E2E_CLERK_ADMIN_USERNAME=
E2E_CLERK_ADMIN_PASSWORD=
